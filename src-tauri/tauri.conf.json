{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twitch Modifiers",
  "version": "0.1.0",
  "identifier": "local.twitch-modifiers.mvp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Twitch Modifiers",
        "url": "index.html?mode=main",
        "width": 1040,
        "height": 760,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Twitch Modifiers Overlay",
        "url": "index.html?mode=overlay",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"]
  }
}
